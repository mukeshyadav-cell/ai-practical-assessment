<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="cq:Template"
          allowedPaths="[/content/dam/assessment/tickets(/.*)?]"
          ranking="{Long}100">
    <jcr:content
            cq:scaffolding="/conf/assessment/settings/dam/cfm/models/ticket/jcr:content/model"
            cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
            jcr:description="Support ticket Content Fragment model"
            jcr:primaryType="cq:PageContent"
            jcr:title="Ticket"
            sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
            sling:resourceType="dam/cfm/models/console/components/data/entity/default"
            status="enabled">
        <metadata jcr:primaryType="nt:unstructured"/>
        <model
                cq:targetPath="/content/dam/assessment/tickets"
                jcr:primaryType="cq:PageContent"
                sling:resourceType="wcm/scaffolding/components/scaffolding"
                dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
                maxGeneratedOrder="20">
            <cq:dialog
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items
                            jcr:primaryType="nt:unstructured"
                            maxGeneratedOrder="9">
                        <ticketId
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="Business identifier (e.g. TKT-1001). Set by repository on create; plain text ID."
                                fieldLabel="Ticket ID"
                                listOrder="1"
                                maxlength="64"
                                metaType="text-single"
                                name="ticketId"
                                renderReadOnly="false"
                                required="on"
                                showEmptyInReadOnly="true"
                                valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </ticketId>
                        <title
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="Ticket title; used for keyword search."
                                fieldLabel="Title"
                                listOrder="2"
                                maxlength="200"
                                metaType="text-single"
                                name="title"
                                renderReadOnly="false"
                                required="on"
                                showEmptyInReadOnly="true"
                                valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </title>
                        <description
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
                                cfm-element="Description"
                                checked="false"
                                default-mime-type="text/plain"
                                fieldDescription="Ticket description (plain text)."
                                fieldLabel="Description"
                                listOrder="3"
                                metaType="text-multi"
                                name="description"
                                renderReadOnly="false"
                                required="on"
                                showEmptyInReadOnly="true"
                                translatable="false"
                                valueType="string/multiline">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </description>
                        <priority
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldDescription="P1 = highest urgency"
                                fieldLabel="Priority"
                                listOrder="4"
                                metaType="enumeration"
                                name="priority"
                                renderReadOnly="false"
                                required="on"
                                showEmptyInReadOnly="true"
                                valueType="string/enum">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                            <optionsmultifield jcr:primaryType="nt:unstructured">
                                <item0
                                        jcr:primaryType="nt:unstructured"
                                        fieldLabel="P1"
                                        fieldValue="P1"/>
                                <item1
                                        jcr:primaryType="nt:unstructured"
                                        fieldLabel="P2"
                                        fieldValue="P2"/>
                                <item2
                                        jcr:primaryType="nt:unstructured"
                                        fieldLabel="P3"
                                        fieldValue="P3"/>
                                <item3
                                        jcr:primaryType="nt:unstructured"
                                        fieldLabel="P4"
                                        fieldValue="P4"/>
                            </optionsmultifield>
                            <datasource
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="dam/cfm/admin/components/datasources/optionrendererenumeration"
                                    variant="default"/>
                        </priority>
                        <status
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldDescription="Ticket lifecycle status. Default Open on create."
                                fieldLabel="Status"
                                listOrder="5"
                                metaType="enumeration"
                                name="status"
                                renderReadOnly="false"
                                required="on"
                                showEmptyInReadOnly="true"
                                valueType="string/enum">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                            <optionsmultifield jcr:primaryType="nt:unstructured">
                                <item0
                                        jcr:primaryType="nt:unstructured"
                                        fieldLabel="Open"
                                        fieldValue="Open"/>
                                <item1
                                        jcr:primaryType="nt:unstructured"
                                        fieldLabel="In Progress"
                                        fieldValue="In Progress"/>
                                <item2
                                        jcr:primaryType="nt:unstructured"
                                        fieldLabel="Resolved"
                                        fieldValue="Resolved"/>
                                <item3
                                        jcr:primaryType="nt:unstructured"
                                        fieldLabel="Closed"
                                        fieldValue="Closed"/>
                                <item4
                                        jcr:primaryType="nt:unstructured"
                                        fieldLabel="Cancelled"
                                        fieldValue="Cancelled"/>
                            </optionsmultifield>
                            <datasource
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="dam/cfm/admin/components/datasources/optionrendererenumeration"
                                    variant="default"/>
                        </status>
                        <assignedTo
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="Assignee userId (plain text FK). Blank = unassigned. NOT a content reference."
                                fieldLabel="Assigned To"
                                listOrder="6"
                                maxlength="128"
                                metaType="text-single"
                                name="assignedTo"
                                renderReadOnly="false"
                                showEmptyInReadOnly="true"
                                valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </assignedTo>
                        <createdBy
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="Creator userId (plain text FK). NOT a content reference."
                                fieldLabel="Created By"
                                listOrder="7"
                                maxlength="128"
                                metaType="text-single"
                                name="createdBy"
                                renderReadOnly="false"
                                required="on"
                                showEmptyInReadOnly="true"
                                valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </createdBy>
                        <createdAt
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="ISO-8601 instant stored as text (e.g. 2025-08-26T10:30:00Z) for DB portability."
                                fieldLabel="Created At"
                                listOrder="8"
                                maxlength="64"
                                metaType="text-single"
                                name="createdAt"
                                renderReadOnly="false"
                                required="on"
                                showEmptyInReadOnly="true"
                                valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </createdAt>
                        <updatedAt
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="ISO-8601 instant stored as text (e.g. 2025-08-26T10:30:00Z) for DB portability."
                                fieldLabel="Updated At"
                                listOrder="9"
                                maxlength="64"
                                metaType="text-single"
                                name="updatedAt"
                                renderReadOnly="false"
                                showEmptyInReadOnly="true"
                                valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </updatedAt>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
