<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
        xmlns:jcr="http://www.jcp.org/jcr/1.0"
        xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
        xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
        xmlns:cq="http://www.day.com/jcr/cq/1.0"
        xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        jcr:primaryType="cq:Template"
        allowedPaths="[/content/dam/assessment/comments(/.*)?]"
        ranking="{Long}100">

    <jcr:content
            cq:scaffolding="/conf/assessment/settings/dam/cfm/models/comment/jcr:content/model"
            cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
            jcr:description="Ticket comment Content Fragment model"
            jcr:primaryType="cq:PageContent"
            jcr:title="Comment"
            sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
            sling:resourceType="dam/cfm/models/console/components/data/entity/default"
            status="enabled">

        <metadata
                jcr:primaryType="nt:unstructured"/>

        <model
                cq:targetPath="/content/dam/assessment/comments"
                jcr:primaryType="cq:PageContent"
                sling:resourceType="wcm/scaffolding/components/scaffolding"
                dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
                maxGeneratedOrder="20">

            <cq:dialog
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="cq/gui/components/authoring/dialog">

                <content
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">

                    <items
                            jcr:primaryType="nt:unstructured"
                            maxGeneratedOrder="5">

                        <commentId
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="Business identifier (e.g. CMT-1001). Set by repository on create; plain text ID."
                                fieldLabel="Comment ID"
                                listOrder="1"
                                maxlength="64"
                                metaType="text-single"
                                name="commentId"
                                renderReadOnly="false"
                                required="on"
                                showEmptyInReadOnly="true"
                                valueType="string">
                            <granite:data
                                    jcr:primaryType="nt:unstructured"/>
                        </commentId>

                        <ticketId
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="Parent ticket ID (plain text FK). NOT a content reference."
                                fieldLabel="Ticket ID"
                                listOrder="2"
                                maxlength="64"
                                metaType="text-single"
                                name="ticketId"
                                renderReadOnly="false"
                                required="on"
                                showEmptyInReadOnly="true"
                                valueType="string">
                            <granite:data
                                    jcr:primaryType="nt:unstructured"/>
                        </ticketId>

                        <message
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
                                cfm-element="Message"
                                checked="false"
                                default-mime-type="text/plain"
                                fieldDescription="Comment message (plain text)."
                                fieldLabel="Message"
                                listOrder="3"
                                metaType="text-multi"
                                name="message"
                                renderReadOnly="false"
                                required="on"
                                showEmptyInReadOnly="true"
                                translatable="false"
                                valueType="string/multiline">
                            <granite:data
                                    jcr:primaryType="nt:unstructured"/>
                        </message>

                        <createdBy
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="Author userId (plain text FK). NOT a content reference."
                                fieldLabel="Created By"
                                listOrder="4"
                                maxlength="128"
                                metaType="text-single"
                                name="createdBy"
                                renderReadOnly="false"
                                required="on"
                                showEmptyInReadOnly="true"
                                valueType="string">
                            <granite:data
                                    jcr:primaryType="nt:unstructured"/>
                        </createdBy>

                        <createdAt
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="ISO-8601 instant stored as text (e.g. 2025-08-26T10:30:00Z) for DB portability."
                                fieldLabel="Created At"
                                listOrder="5"
                                maxlength="64"
                                metaType="text-single"
                                name="createdAt"
                                renderReadOnly="false"
                                required="on"
                                showEmptyInReadOnly="true"
                                valueType="string">
                            <granite:data
                                    jcr:primaryType="nt:unstructured"/>
                        </createdAt>

                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
